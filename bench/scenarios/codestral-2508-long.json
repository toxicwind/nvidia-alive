{
  "benchmarks": [
    {}
  ],
  "metadata": {
    "name": "general-chat-codestral-2508-long",
    "description": "General-chat benchmark (long): codestral-2508 on mistral (5824 prompt / 728 output tokens, synchronous, 50 requests).",
    "model": "codestral-2508",
    "provider": "mistral",
    "variant": "long",
    "prompt_tokens": 5824,
    "output_tokens": 728,
    "tokens_scaled_to_context": true,
    "max_context_advertised": 131072,
    "context_effective": 131072,
    "context_provisional": false,
    "context_source": "https://github.com/mistralai/platform-docs-public known-limitations.md ('Codestral | 128k tokens', updated 2026-09-17)",
    "context_note": "Mistral's own docs list Codestral at 128k. OpenRouter's live catalog says 256000 for mistralai/codestral-2508 -- conflict; Mistral docs win for the direct Mistral API.",
    "tokenizer": "mistralai/Codestral-22B-v0.1",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://api.mistral.ai",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 5824,
        "output_tokens": 728
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
        "kind": "max_duration",
        "seconds": 1800
      },
      {
        "kind": "max_errors",
        "count": 10
      }
    ]
  }
}
