{
  "benchmarks": [
    {}
  ],
  "metadata": {
    "name": "general-chat-mistral-code-fim-latest",
    "description": "General-chat benchmark (standard): mistral-code-fim-latest on mistral (1024 prompt / 512 output tokens, synchronous, 50 requests).",
    "model": "mistral-code-fim-latest",
    "provider": "mistral",
    "variant": "standard",
    "prompt_tokens": 1024,
    "output_tokens": 512,
    "tokens_scaled_to_context": false,
    "max_context_advertised": null,
    "context_effective": null,
    "context_provisional": true,
    "context_source": null,
    "context_note": "No published context window found for the FIM variant; same family as mistral-code-latest (256k) but unstated. Do not size prompts against it until verified.",
    "tokenizer": "mistralai/Codestral-22B-v0.1",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://api.mistral.ai",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 1024,
        "output_tokens": 512
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
        "kind": "max_duration",
        "seconds": 1800
      },
      {
        "kind": "max_errors",
        "count": 10
      }
    ]
  }
}
