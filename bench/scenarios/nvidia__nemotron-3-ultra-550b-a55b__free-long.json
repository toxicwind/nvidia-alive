  ],
  "metadata": {
    "name": "general-chat-nvidia__nemotron-3-ultra-550b-a55b__free-long",
    "description": "General-chat benchmark (long): nvidia/nemotron-3-ultra-550b-a55b:free on openrouter (8192 prompt / 1024 output tokens, synchronous, 50 requests).",
    "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "provider": "openrouter",
    "variant": "long",
    "prompt_tokens": 8192,
    "output_tokens": 1024,
    "tokens_scaled_to_context": false,
    "max_context_advertised": 1000000,
    "context_effective": 262144,
    "context_provisional": false,
    "context_source": "https://openrouter.ai/api/v1/models",
    "context_note": "OpenRouter serving config caps at 1000000.",
    "tokenizer": "nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://openrouter.ai/api/v1",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 8192,
        "output_tokens": 1024
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
