{
  "benchmarks": [
    {}
  ],
  "metadata": {
    "name": "general-chat-codestral-latest-long",
    "description": "General-chat benchmark (long): codestral-latest on mistral (5824 prompt / 728 output tokens, synchronous, 50 requests).",
    "model": "codestral-latest",
    "provider": "mistral",
    "variant": "long",
    "prompt_tokens": 5824,
    "output_tokens": 728,
    "tokens_scaled_to_context": true,
    "max_context_advertised": 131072,
    "context_effective": 131072,
    "context_provisional": true,
    "context_source": "https://github.com/mistralai/platform-docs-public known-limitations.md",
    "context_note": "-latest alias floats; Mistral docs list Codestral at 128k. Codestral 2 (256k, Apr 2026) exists -- alias may repoint. Re-verify when pinning.",
    "tokenizer": "mistralai/Codestral-22B-v0.1",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://api.mistral.ai",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 5824,
        "output_tokens": 728
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
        "kind": "max_duration",
        "seconds": 1800
      },
      {
        "kind": "max_errors",
        "count": 10
      }
    ]
  }
}
