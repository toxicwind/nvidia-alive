  "metadata": {
    "name": "general-chat-nvidia__nemotron-3-ultra-550b-a55b-long",
    "description": "General-chat benchmark (long): nvidia/nemotron-3-ultra-550b-a55b on nvidia (8192 prompt / 1024 output tokens, synchronous, 50 requests).",
    "model": "nvidia/nemotron-3-ultra-550b-a55b",
    "provider": "nvidia",
    "variant": "long",
    "prompt_tokens": 8192,
    "output_tokens": 1024,
    "tokens_scaled_to_context": false,
    "max_context_advertised": 1048576,
    "context_effective": 262144,
    "context_provisional": false,
    "context_source": "https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b.md ('Up to 1M tokens'; 'Defaults to 256k')",
    "context_note": "Card says 'Up to 1M' but notes 'Defaults to 256k'. Same 1M-marketing/256k-default split as super-120b. Size GuideLLM runs at 256k.",
    "tokenizer": "nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://integrate.api.nvidia.com",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 8192,
        "output_tokens": 1024
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
        "kind": "max_duration",
        "seconds": 1800
      },
      {
        "kind": "max_errors",
        "count": 10
      }
    ]
  }
