{
  "benchmarks": [
    {}
  ],
  "metadata": {
    "name": "general-chat-gemma-4-26b-a4b-it-long",
    "description": "General-chat benchmark (long): gemma-4-26b-a4b-it on gemini (8192 prompt / 1024 output tokens, synchronous, 50 requests).",
    "model": "gemma-4-26b-a4b-it",
    "provider": "gemini",
    "variant": "long",
    "prompt_tokens": 8192,
    "output_tokens": 1024,
    "tokens_scaled_to_context": false,
    "max_context_advertised": 262144,
    "context_effective": 262144,
    "context_provisional": false,
    "context_source": "https://openrouter.ai/api/v1/models (context_length 262144); https://openrouter.ai/google/gemma-4-26b-a4b-it",
    "context_note": "Multiple agreeing sources (OpenRouter 262K, Fireworks 262k, Cloudflare 256k). max_completion from OpenRouter top_provider.",
    "tokenizer": "nvidia/Gemma-4-26B-A4B-NVFP4",
    "tokenizer_verified": true
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "https://generativelanguage.googleapis.com/v1beta/openai",
      "request_format": "/v1/chat/completions"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 8192,
        "output_tokens": 1024
      }
    ],
    "profile": {
      "kind": "synchronous"
    },
    "constraints": [
      {
        "kind": "max_requests",
        "count": 50
      },
      {
        "kind": "max_duration",
        "seconds": 1800
      },
      {
        "kind": "max_errors",
        "count": 10
      }
    ]
  }
}
